<!doctype html>
<html lang="<%= it.locale %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title><%= it.pageTitle %> · <%= it.title %></title>
    <link rel="stylesheet" href="/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/fontawesome/css/solid.min.css" />
    <link rel="stylesheet" href="/ui-assets/setup.css" />
    <% for (const script of it.scripts) { %>
    <script type="module" src="<%= script %>"></script>
    <% } %>
  </head>
  <body>
    <div
      id="app"
      class="app-layout"
      data-page="<%= it.activePage %>"
      data-live-reload="<%= it.liveReload %>"
      data-version="<%= it.version %>"
      data-locale="<%= it.locale %>"
      v-cloak
    >
      <aside class="sidebar" id="sidebar" aria-label="<%= it.t("navigation.mainLabel") %>">
        <a class="sidebar__brand" href="/setup" aria-label="<%= it.t("navigation.home") %>">
          <span class="brand__mark"><i class="fa-solid fa-flask-vial" aria-hidden="true"></i></span>
          <span class="sidebar__label"><strong><%= it.t("common.productName") %></strong><small><%= it.t("common.localTestEnvironment") %></small></span>
        </a>
        <nav class="sidebar__nav">
          <% for (const item of it.navigation) { %>
          <a
            class="sidebar__link<%= item.id === it.activePage ? " is-active" : "" %>"
            href="<%= item.href %>"
            <% if (item.id === it.activePage) { %>
            aria-current="page"
            <% } %>
          >
            <i class="fa-solid <%= item.icon %>" aria-hidden="true"></i>
            <span class="sidebar__label"><%= item.label %></span>
          </a>
          <% if (item.id === it.activePage && it.subnavigation.length > 0) { %>
          <div class="sidebar__subnav" aria-label="<%= it.t("navigation.documentationSections") %>">
            <% for (const subitem of it.subnavigation) { %>
            <a class="sidebar__sublink" href="<%= subitem.href %>">
              <span class="sidebar__label"><%= subitem.label %></span>
            </a>
            <% } %>
          </div>
          <% } %>
          <% } %>
        </nav>
        <div class="sidebar__bottom">
          <button
            class="sidebar__collapse"
            id="sidebar-collapse"
            type="button"
            :aria-expanded="String(!sidebarCollapsed)"
            :aria-label="sidebarCollapsed ? t('navigation.expandMenu') : t('navigation.collapseMenu')"
            :title="sidebarCollapsed ? t('navigation.expandMenu') : t('navigation.collapseMenu')"
            @click="toggleSidebar"
          >
            <i :class="['fa-solid', sidebarCollapsed ? 'fa-angles-right' : 'fa-angles-left']" aria-hidden="true"></i>
          </button>
          <footer class="sidebar__footer">
            <nav class="sidebar__footer-links" aria-label="<%= it.t("navigation.statusAndLegal") %>">
              <a
                class="sidebar__footer-link sidebar__footer-link--health"
                href="/health"
                title="<%= it.t("navigation.serverStatus") %>">
                <i class="fa-solid fa-heart-pulse" aria-hidden="true"></i>
                <span class="sidebar__label"><%= it.t("navigation.serverStatus") %></span>
              </a>
              <a class="sidebar__footer-link" href="/LICENSE.txt" title="<%= it.t("navigation.license") %>">
                <i class="fa-solid fa-scale-balanced" aria-hidden="true"></i>
                <span class="sidebar__label"><%= it.t("navigation.license") %></span>
              </a>
              <a
                class="sidebar__footer-link"
                href="/THIRD_PARTY_LICENSES.txt"
                title="<%= it.t("navigation.thirdPartyLicenses") %>">
                <i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i>
                <span class="sidebar__label"><%= it.t("navigation.thirdPartyLicenses") %></span>
              </a>
            </nav>
          </footer>
        </div>
      </aside>

      <button
        class="sidebar-backdrop"
        id="sidebar-backdrop"
        type="button"
        aria-label="<%= it.t("navigation.closeMenu") %>"
        :hidden="!mobileMenuOpen"
        @click="closeMobileMenu"
      ></button>

      <div class="app-content">
        <div class="app-header">
          <div class="remote-banner" id="remote-banner" role="status" :hidden="connection.mode !== 'remote'">
            <span
              ><i class="fa-solid fa-satellite-dish" aria-hidden="true"></i>
              <strong id="remote-banner-name">{{ connection.remote?.instanceName }}</strong
              ><span id="remote-banner-detail">{{ remoteBannerDetail }}</span></span
            >
            <span class="remote-banner__actions">
              <button
                class="button button--secondary"
                id="remote-banner-retry"
                type="button"
                v-if="connection.reachable === false"
                :disabled="shellBusy"
                @click="retryRemote"
              >
                {{ t('common.actions.retry') }}
              </button>
              <button
                class="button button--secondary"
                id="remote-banner-disconnect"
                type="button"
                :disabled="shellBusy"
                @click="disconnectRemote"
              >
                {{ t('common.actions.disconnect') }}
              </button>
            </span>
          </div>
          <header class="topbar">
            <button
              class="menu-toggle"
              id="menu-toggle"
              type="button"
              aria-controls="sidebar"
              :aria-expanded="String(mobileMenuOpen)"
              @click="toggleMobileMenu"
            >
              <i class="fa-solid fa-bars" aria-hidden="true"></i
              ><span class="visually-hidden"><%= it.t("navigation.openMenu") %></span>
            </button>
            <a class="mobile-brand" href="/setup">Browser Testbench</a>
            <div class="topbar__actions">
              <div class="host-badge" id="host-badge" aria-live="polite">
                <i :class="['fa-solid', badgeIcon]" aria-hidden="true"></i> {{ badgeLabel }}
              </div>
              <% if (it.refreshEnvironment) { %>
              <button
                class="button button--secondary topbar__refresh"
                id="refresh-environment"
                type="button"
                :disabled="store.busy"
                @click="store.refresh({ analyze: true })"
              >
                <i :class="['fa-solid', store.loading ? 'fa-spinner fa-spin' : 'fa-rotate']" aria-hidden="true"></i>
                <span class="topbar__refresh-label"
                  >{{ store.loading ? t('common.actions.checking') : t('common.actions.checkAgain') }}</span
                >
              </button>
              <% } %>
            </div>
          </header>
        </div>

        <main class="shell page-content" :aria-busy="String(store.loading)"><%~ it.content %></main>
        <% if (it.refreshEnvironment) { %>
        <div
          class="content-analysis"
          id="environment-analysis"
          role="status"
          aria-live="polite"
          :hidden="!store.analyzing"
        >
          <div class="content-analysis__content">
            <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>
            <strong><%= it.t("common.pleaseWait") %></strong>
            <span><%= it.t("common.analyzingEnvironment") %></span>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </body>
</html>
