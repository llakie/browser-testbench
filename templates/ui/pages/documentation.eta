<section class="hero hero--compact">
  <div>
    <p class="eyebrow"><%= it.t("documentation.content.reference") %></p>
    <h1><%= it.t("documentation.content.title") %></h1>
    <p class="hero__copy"><%= it.t("documentation.content.intro") %></p>
  </div>
</section>

<article class="docs-content panel">
  <section id="start">
    <p class="eyebrow"><%= it.t("documentation.content.quick.eyebrow") %></p>
    <h2><%= it.t("documentation.content.quick.title") %></h2>
    <ol>
      <li><%= it.t("documentation.content.quick.step1") %></li>
      <li><%= it.t("documentation.content.quick.step2Before") %> <a href="/setup"><%= it.t("documentation.content.quick.step2Link") %></a><%= it.t("documentation.content.quick.step2After") %></li>
      <li><%= it.t("documentation.content.quick.step3") %></li>
      <li><%= it.t("documentation.content.quick.step4Before") %> <a href="/targets"><%= it.t("documentation.content.quick.step4Link") %></a><%= it.t("documentation.content.quick.step4After") %></li>
      <li><%= it.t("documentation.content.quick.step5") %></li>
    </ol>
    <pre><code>npm install --global browser-testbench
browser-testbench start</code></pre>
    <p><%= it.t("documentation.content.quick.projectCommand") %></p>
    <pre><code>npm install --save-dev browser-testbench</code></pre>
  </section>

  <section id="remote">
    <p class="eyebrow"><%= it.t("documentation.content.remote.eyebrow") %></p>
    <h2><%= it.t("documentation.content.remote.title") %></h2>
    <p><%= it.t("documentation.content.remote.intro") %></p>
    <pre><code>browser-testbench discover
browser-testbench connect &lt;name-or-instance-id&gt;
browser-testbench status
browser-testbench disconnect</code></pre>
    <p><%= it.t("documentation.content.remote.network") %></p>
  </section>

  <section id="targets">
    <p class="eyebrow"><%= it.t("documentation.content.targetIds.eyebrow") %></p>
    <h2><%= it.t("documentation.content.targetIds.title") %></h2>
    <p><%= it.t("documentation.content.targetIds.intro") %></p>
  </section>

  <section id="automation">
    <p class="eyebrow"><%= it.t("documentation.content.automation.eyebrow") %></p>
    <h2><%= it.t("documentation.content.automation.title") %></h2>
    <p><%= it.t("documentation.content.automation.intro") %></p>
    <pre><code>npm install --save-dev browser-testbench</code></pre>
    <pre><code>import { RemoteTestbench } from "browser-testbench/client";

const testbench = new RemoteTestbench();
const targets = await testbench.availableTargets(["chrome"]);

await testbench.forEachTarget(targets, { url: "http://127.0.0.1:3000" }, async browser => {
  await browser.fill("#email", "test@example.com");
  await browser.click('button[type="submit"]');
  await browser.waitForText("Welcome");
});</code></pre>
  </section>

  <section id="debugging">
    <p class="eyebrow"><%= it.t("documentation.content.debugging.eyebrow") %></p>
    <h2><%= it.t("documentation.content.debugging.title") %></h2>
    <p><%= it.t("documentation.content.debugging.intro") %></p>
    <pre><code>browser-testbench open --target chrome --url http://127.0.0.1:3000</code></pre>
  </section>

  <section id="mobile">
    <p class="eyebrow"><%= it.t("documentation.content.mobile.eyebrow") %></p>
    <h2><%= it.t("documentation.content.mobile.title") %></h2>
    <p><%= it.t("documentation.content.mobile.intro") %></p>
  </section>

  <section id="physical-android">
    <p class="eyebrow"><%= it.t("documentation.content.android.eyebrow") %></p>
    <h2><%= it.t("documentation.content.android.title") %></h2>
    <device-setup-checklist platform="android"></device-setup-checklist>
    <details class="docs-disclosure" id="android-detailed-setup">
      <summary><%= it.t("documentation.content.android.showGuide") %></summary>
      <div class="docs-disclosure__content">
        <details class="docs-accordion" id="android-tools" name="android-setup">
          <summary>
            <%= it.t("documentation.content.android.toolsTitle") %>
            <i class="fa-solid fa-chevron-down docs-accordion__chevron" aria-hidden="true"></i>
          </summary>
          <div class="docs-accordion__content">
            <ol>
              <li><%= it.t("documentation.content.android.tools1") %></li>
              <li>
                <%= it.t("documentation.content.android.tools2Before") %> <a href="/setup#environment-setup"><%= it.t("documentation.content.android.environmentSetup") %></a><%= it.t("documentation.content.android.tools2After") %>
              </li>
            </ol>
          </div>
        </details>
        <details class="docs-accordion" id="android-device-connection" name="android-setup">
          <summary>
            <%= it.t("documentation.content.android.deviceTitle") %>
            <i class="fa-solid fa-chevron-down docs-accordion__chevron" aria-hidden="true"></i>
          </summary>
          <div class="docs-accordion__content">
            <ol>
              <li><%= it.t("documentation.content.android.device1") %></li>
              <li><%= it.t("documentation.content.android.device2") %></li>
              <li><%= it.t("documentation.content.android.device3") %></li>
            </ol>
          </div>
        </details>
        <details class="docs-accordion" id="android-debugging" name="android-setup">
          <summary>
            <%= it.t("documentation.content.android.debugTitle") %>
            <i class="fa-solid fa-chevron-down docs-accordion__chevron" aria-hidden="true"></i>
          </summary>
          <div class="docs-accordion__content">
            <ol>
              <li><%= it.t("documentation.content.android.debug1") %></li>
              <li><%= it.t("documentation.content.android.debug2") %></li>
              <li><%= it.t("documentation.content.android.debug3Before") %> <a href="/setup"><%= it.t("documentation.content.android.overview") %></a> <%= it.t("documentation.content.android.debug3After") %></li>
            </ol>
          </div>
        </details>
        <details class="docs-accordion" id="android-first-test" name="android-setup">
          <summary>
            <%= it.t("documentation.content.android.testTitle") %>
            <i class="fa-solid fa-chevron-down docs-accordion__chevron" aria-hidden="true"></i>
          </summary>
          <div class="docs-accordion__content">
            <p><%= it.t("documentation.content.android.test1Before") %> <a href="/targets"><%= it.t("documentation.content.android.testTargets") %></a> <%= it.t("documentation.content.android.test1After") %></p>
            <p><%= it.t("documentation.content.android.test2") %></p>
          </div>
        </details>
      </div>
    </details>
  </section>

  <section id="physical-ios">
    <p class="eyebrow"><%= it.t("documentation.content.ios.eyebrow") %></p>
    <h2><%= it.t("documentation.content.ios.title") %></h2>
    <device-setup-checklist platform="ios"></device-setup-checklist>
    <details class="docs-disclosure" id="ios-detailed-setup">
      <summary><%= it.t("documentation.content.ios.showGuide") %></summary>
      <div class="docs-disclosure__content">
        <details class="docs-accordion" id="ios-mac-setup" name="ios-setup">
          <summary>
            <%= it.t("documentation.content.ios.toolsTitle") %>
            <i class="fa-solid fa-chevron-down docs-accordion__chevron" aria-hidden="true"></i>
          </summary>
          <div class="docs-accordion__content">
            <ol>
              <li><%= it.t("documentation.content.ios.tools1") %></li>
              <li><%= it.t("documentation.content.ios.tools2") %></li>
              <li>
                <%= it.t("documentation.content.ios.tools3Before") %> <a href="/setup#environment-setup"><%= it.t("documentation.content.android.environmentSetup") %></a> <%= it.t("documentation.content.ios.tools3After") %>
              </li>
            </ol>
          </div>
        </details>
        <details class="docs-accordion" id="ios-device-connection" name="ios-setup">
          <summary>
            <%= it.t("documentation.content.ios.deviceTitle") %>
            <i class="fa-solid fa-chevron-down docs-accordion__chevron" aria-hidden="true"></i>
          </summary>
          <div class="docs-accordion__content">
            <ol>
              <li><%= it.t("documentation.content.ios.device1") %></li>
              <li><%= it.t("documentation.content.ios.device2") %></li>
              <li><%= it.t("documentation.content.ios.device3") %></li>
            </ol>
          </div>
        </details>
        <details class="docs-accordion" id="ios-safari-settings" name="ios-setup">
          <summary>
            <%= it.t("documentation.content.ios.safariTitle") %>
            <i class="fa-solid fa-chevron-down docs-accordion__chevron" aria-hidden="true"></i>
          </summary>
          <div class="docs-accordion__content">
            <ol>
              <li><%= it.t("documentation.content.ios.safari1") %></li>
              <li><%= it.t("documentation.content.ios.safari2") %></li>
            </ol>
          </div>
        </details>
        <details class="docs-accordion" id="ios-signing" name="ios-setup">
          <summary>
            <%= it.t("documentation.content.ios.signingTitle") %>
            <i class="fa-solid fa-chevron-down docs-accordion__chevron" aria-hidden="true"></i>
          </summary>
          <div class="docs-accordion__content">
            <p><%= it.t("documentation.content.ios.signingIntro") %></p>
            <h4><%= it.t("documentation.content.ios.identityTitle") %></h4>
            <ol>
              <li>
                <%= it.t("documentation.content.ios.identity1Before") %> <a href="/setup#environment-setup"><%= it.t("documentation.content.android.environmentSetup") %></a> <%= it.t("documentation.content.ios.identity1After") %>
              </li>
              <li><%= it.t("documentation.content.ios.identity2") %></li>
              <li><%= it.t("documentation.content.ios.identity3") %></li>
            </ol>
            <p><%= it.t("documentation.content.ios.teamId") %></p>
            <h4><%= it.t("documentation.content.ios.certificateTitle") %></h4>
            <ol>
              <li><%= it.t("documentation.content.ios.certificate1") %></li>
              <li>
                <%= it.t("documentation.content.ios.certificate2Before") %>
                <a href="https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer"><%= it.t("documentation.content.ios.certificateLink") %></a>
                <%= it.t("documentation.content.ios.certificate2After") %>
              </li>
            </ol>
            <h4><%= it.t("documentation.content.ios.runTitle") %></h4>
            <ol>
              <li><%= it.t("documentation.content.ios.run1") %></li>
              <li><%= it.t("documentation.content.ios.run2") %></li>
              <li><%= it.t("documentation.content.ios.run3") %></li>
              <li><%= it.t("documentation.content.ios.run4") %></li>
              <li><%= it.t("documentation.content.ios.run5Before") %> <a href="/targets"><%= it.t("documentation.content.android.testTargets") %></a> <%= it.t("documentation.content.ios.run5After") %></li>
            </ol>
            <p><%= it.t("documentation.content.ios.expiry") %></p>
          </div>
        </details>
        <details class="docs-accordion" id="ios-xcode-compatibility" name="ios-setup">
          <summary>
            <%= it.t("documentation.content.ios.compatTitle") %>
            <i class="fa-solid fa-chevron-down docs-accordion__chevron" aria-hidden="true"></i>
          </summary>
          <div class="docs-accordion__content">
            <p><%= it.t("documentation.content.ios.compatIntro") %></p>
            <ol>
              <li>
                <%= it.t("documentation.content.ios.compat1Before") %>
                <a href="https://developer.apple.com/download/all/?q=Xcode%2026.2"><%= it.t("documentation.content.ios.compatLink") %></a>
                <%= it.t("documentation.content.ios.compat1After") %>
              </li>
              <li><%= it.t("documentation.content.ios.compat2") %></li>
              <li>
                <%= it.t("documentation.content.ios.compat3") %>
                <pre><code>sudo xcode-select --switch /Applications/Xcode-26.2.app/Contents/Developer
xcodebuild -version</code></pre>
              </li>
              <li><%= it.t("documentation.content.ios.compat4") %></li>
              <li><%= it.t("documentation.content.ios.compat5") %></li>
            </ol>
          </div>
        </details>
        <details class="docs-accordion" id="ios-network-access" name="ios-setup">
          <summary>
            <%= it.t("documentation.content.ios.networkTitle") %>
            <i class="fa-solid fa-chevron-down docs-accordion__chevron" aria-hidden="true"></i>
          </summary>
          <div class="docs-accordion__content">
            <p><%= it.t("documentation.content.ios.networkIntro") %></p>
            <p>
              <% if (it.remoteExecution) { %><%= it.t("documentation.content.ios.networkRemote") %><% } else if (it.localNetworkAddress) { %><%=
it.t("documentation.content.ios.networkLocal", {
  address: it.localNetworkAddress,
})
%><% } else { %><%= it.t("documentation.content.ios.networkMissing") %><% } %>
            </p>
          </div>
        </details>
      </div>
    </details>
  </section>

  <section id="mobile-controls">
    <p class="eyebrow"><%= it.t("documentation.content.controls.eyebrow") %></p>
    <h2><%= it.t("documentation.content.controls.title") %></h2>
    <p><%= it.t("documentation.content.controls.intro") %></p>
    <pre><code>import { BrowserOrientation, PinchDirection, SwipeDirection } from "browser-testbench/client";

await browser.setOrientation(BrowserOrientation.Landscape);
await browser.swipe({ direction: SwipeDirection.Up });
await browser.pinch({ direction: PinchDirection.Out });</code></pre>
  </section>
</article>

<script type="text/x-template" id="device-setup-checklist-template">
  <div class="setup-checklist" :id="elementId" aria-live="polite">
    <div class="setup-checklist__heading">
      <div>
        <p class="eyebrow">{{ t('checklist.eyebrow') }}</p>
        <h3>{{ heading }}</h3>
        <p>{{ intro }}</p>
      </div>
      <button class="button button--secondary" type="button" :disabled="store.loading" @click="refresh">
        <i :class="['fa-solid', store.loading ? 'fa-spinner fa-spin' : 'fa-rotate']" aria-hidden="true"></i>
        {{ store.loading ? t('common.actions.checking') : t('common.actions.checkAgain') }}
      </button>
    </div>
    <label class="setup-checklist__device-picker" v-if="physicalDevices.length > 1">
      <span>{{ t('checklist.deviceLabel') }}</span>
      <select v-model="selectedDeviceId">
        <option v-for="deviceOption in physicalDevices" :key="deviceOption.id" :value="deviceOption.id">
          {{ deviceOption.name }}{{ deviceOption.platformVersion ? ` · ${deviceOption.platformVersion}` : '' }}
        </option>
      </select>
    </label>
    <div class="setup-checklist__steps" v-if="workbench">
      <details class="setup-checklist__group is-complete" v-if="completedSteps.length">
        <summary>
          <span class="setup-checklist__icon"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
          <strong>{{ t('checklist.completed', { count: completedSteps.length }, completedSteps.length) }}</strong>
          <i class="fa-solid fa-chevron-down setup-checklist__chevron" aria-hidden="true"></i>
        </summary>
        <div class="setup-checklist__compact-list">
          <div
            class="setup-checklist__compact-step is-complete"
            v-for="step in completedSteps"
            :key="step.id"
            :data-step-id="step.id"
          >
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            <span>{{ stepNumber(step) }}. {{ step.label }}</span>
          </div>
        </div>
      </details>
      <article
        class="setup-checklist__step setup-checklist__current"
        v-if="currentStep"
        :data-step-id="currentStep.id"
        :class="`is-${status(currentStep)}`"
      >
        <span class="setup-checklist__icon">
          <i :class="['fa-solid', statusIcon(status(currentStep))]" aria-hidden="true"></i>
        </span>
        <div class="setup-checklist__copy">
          <div class="setup-checklist__title">
            <strong>{{ stepNumber(currentStep) }}. {{ currentStep.label }}</strong>
            <span>{{ statusLabel(status(currentStep)) }}</span>
          </div>
          <p>{{ currentStep.detail }}</p>
          <label class="setup-checklist__confirmation" v-if="currentStep.manual">
            <input type="checkbox" @change="confirmManualStep($event.target.checked)" />
            <span>{{ t('checklist.confirmation') }}</span>
          </label>
          <details class="setup-checklist__troubleshooting" v-if="currentStep.troubleshooting?.length">
            <summary>{{ t('checklist.troubleshooting') }}</summary>
            <ul>
              <li v-for="hint in currentStep.troubleshooting" :key="hint.text">
                {{ hint.text }}
                <a v-if="hint.href" :href="hint.href">{{ hint.linkLabel ?? t('checklist.openHelp') }}</a>
              </li>
            </ul>
          </details>
          <a :href="currentStep.href" @click="openInstructions(currentStep.href)">{{ t('checklist.openInstructions') }}</a>
        </div>
      </article>
      <p class="setup-checklist__complete" v-else>
        <i class="fa-solid fa-circle-check" aria-hidden="true"></i> {{ completionText }}
      </p>
      <details class="setup-checklist__group" v-if="laterSteps.length">
        <summary>
          <span class="setup-checklist__icon"><i class="fa-solid fa-clock" aria-hidden="true"></i></span>
          <strong>{{ t('checklist.later', { count: laterSteps.length }, laterSteps.length) }}</strong>
          <i class="fa-solid fa-chevron-down setup-checklist__chevron" aria-hidden="true"></i>
        </summary>
        <div class="setup-checklist__compact-list">
          <div class="setup-checklist__compact-step" v-for="step in laterSteps" :key="step.id" :data-step-id="step.id">
            <i class="fa-solid fa-clock" aria-hidden="true"></i>
            <span>{{ stepNumber(step) }}. {{ step.label }}</span>
          </div>
        </div>
      </details>
    </div>
  </div>
</script>
