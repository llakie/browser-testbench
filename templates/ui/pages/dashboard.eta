<template id="overview-page-template">
  <div>
    <section class="hero">
      <div>
        <p class="eyebrow">{{ t('overview.page.eyebrow') }}</p>
        <h1><%= it.t("overview.page.title") %></h1>
        <p class="hero__copy">{{ t('overview.page.intro') }}</p>
      </div>
    </section>
    <div
      id="notice"
      :class="['notice', store.state.notice?.kind ? `is-${store.state.notice.kind}` : '']"
      role="status"
      aria-live="polite"
      v-if="store.state.notice"
    >
      {{ store.state.notice.message }}
    </div>
    <template v-if="workbench">
      <details class="panel accordion-panel" id="remote-connection" name="overview-panel" :hidden="!remotePanelVisible">
        <summary class="accordion-panel__summary">
          <div>
            <p class="eyebrow">{{ t('overview.page.remoteEyebrow') }}</p>
            <h2 id="remote-connection-title">{{ remoteTitle }}</h2>
            <p id="remote-connection-summary">{{ remoteSummary }}</p>
          </div>
          <i class="fa-solid fa-chevron-down accordion-panel__icon" aria-hidden="true"></i>
        </summary>
        <div class="accordion-panel__body">
          <div v-show="!managesClients">
            <div class="accordion-panel__toolbar">
              <button
                class="button button--secondary"
                id="discover-remotes"
                type="button"
                :hidden="managesClients"
                :disabled="actionBusy === 'discover'"
                @click="discoverRemotes"
              >
                <i
                  :class="['fa-solid', actionBusy === 'discover' ? 'fa-spinner fa-spin' : 'fa-satellite-dish']"
                  aria-hidden="true"
                ></i>
                {{ actionBusy === 'discover' ? t('overview.page.searching') : t('overview.page.findTestbenches') }}
              </button>
            </div>
            <div class="remote-discovery" id="remote-discovery" v-if="discovered">
              <article class="remote-instance" v-for="instance in discovered" :key="instance.instanceId">
                <div>
                  <strong>{{ instance.name }}</strong
                  ><small
                    >{{ instance.platform }}/{{ instance.architecture }} · {{ instance.authentication }} · {{
                    instance.url }}</small
                  >
                </div>
                <button
                  class="button button--secondary"
                  type="button"
                  :disabled="actionBusy === `connect:${instance.instanceId}`"
                  @click="connectRemote(instance)"
                >
                  {{ t('overview.page.connect') }}
                </button>
              </article>
              <p v-if="discovered.length === 0">{{ t('overview.page.noneFound') }}</p>
            </div>
            <form class="remote-manual" id="remote-manual" :hidden="managesClients" @submit.prevent="connectManual">
              <label
                ><span>{{ t('overview.page.testbenchUrl') }}</span>
                <div class="input-with-icon">
                  <i class="fa-solid fa-link" aria-hidden="true"></i
                  ><input
                    id="remote-server-url"
                    v-model="remoteUrl"
                    type="url"
                    placeholder="http://remote-host:55808"
                    required
                  /></div></label
              ><label class="remote-admin-option"
                ><input id="remote-admin" v-model="requestAdmin" type="checkbox" /> {{ t('overview.page.requestAdmin')
                }}</label
              ><button class="button button--secondary" type="submit" :disabled="actionBusy === 'connect-manual'">
                {{ t('overview.page.connect') }}
              </button>
            </form>
            <form class="pairing-form" id="pairing-form" v-if="pendingPairingId" @submit.prevent="completePairing">
              <label
                ><span>{{ t('overview.page.pairingCode') }}</span
                ><input
                  id="pairing-code"
                  v-model="pairingCode"
                  inputmode="numeric"
                  pattern="[0-9]{6}"
                  maxlength="6"
                  autocomplete="one-time-code"
                  required /></label
              ><button class="button" type="submit" :disabled="actionBusy === 'pair'">
                {{ t('overview.page.pairAndConnect') }}
              </button>
            </form>
          </div>
          <div class="pairing-requests" id="pairing-requests" v-if="workbench.pairingRequests?.length">
            <article class="remote-instance" v-for="request in workbench.pairingRequests" :key="request.pairingId">
              <div>
                <strong
                  >{{ t(request.role === 'admin' ? 'overview.page.administrativePairing' :
                  'overview.page.controlPairing') }}</strong
                ><small
                  >{{ t('overview.page.pairingMeta', { code: request.code, date: formatDate(request.expiresAt, {
                  timeStyle: 'short' }) }) }}</small
                >
              </div>
            </article>
          </div>
          <div class="remote-clients" id="remote-clients" v-if="managesClients">
            <div class="subsection-heading">
              <h3>{{ t('overview.page.pairedClients') }}</h3>
              <p>{{ t('overview.page.pairedClientsIntro') }}</p>
            </div>
            <p class="remote-clients__empty" id="remote-clients-empty" v-if="!workbench.authorizedClients?.length">
              {{ t('overview.page.noClients') }}
            </p>
            <div class="remote-discovery" id="remote-client-list">
              <article class="remote-instance" v-for="client in workbench.authorizedClients" :key="client.clientId">
                <div>
                  <strong>{{ client.name }}</strong
                  ><small
                    >{{ t(`common.remoteRole.${client.role}`) }} · {{ client.connected ?
                    t('common.connection.connected') : t('overview.page.lastUsed', { date: formatDate(client.lastUsedAt)
                    }) }}</small
                  >
                </div>
                <div class="remote-client-actions">
                  <button class="button button--secondary" type="button" @click="setRole(client)">
                    {{ t(client.role === 'admin' ? 'overview.page.setControl' : 'overview.page.makeAdmin') }}</button
                  ><button class="button button--secondary" type="button" @click="revoke(client)">
                    {{ t('overview.page.revoke') }}
                  </button>
                </div>
              </article>
            </div>
          </div>
        </div>
      </details>
      <details class="panel accordion-panel" id="environment" name="overview-panel" open>
        <summary class="accordion-panel__summary">
          <div>
            <p class="eyebrow">{{ t('common.localTestEnvironment') }}</p>
            <h2>{{ t('overview.page.environmentTitle') }}</h2>
            <p>{{ t('overview.page.environmentIntro') }}</p>
          </div>
          <i class="fa-solid fa-chevron-down accordion-panel__icon" aria-hidden="true"></i>
        </summary>
        <div class="accordion-panel__body">
          <div class="environment-group environment-group--capabilities">
            <div class="subsection-heading">
              <h3>{{ t('overview.page.availability') }}</h3>
              <p>{{ t('overview.page.availabilityIntro') }}</p>
            </div>
            <div class="check-grid" id="checks" aria-live="polite">
              <article
                v-for="check in workbench.checks"
                :key="check.id"
                :data-check-id="check.id"
                :class="['check-card', `is-${check.status}`, { 'check-card--device': ['safari-ios', 'chrome-android'].includes(check.id) }]"
              >
                <div class="check-card__title">
                  {{ localized(check, 'label') }}<span class="status-icon"
                    ><i :class="['fa-solid', statusIcon(check.status)]" aria-hidden="true"></i
                  ></span>
                </div>
                <p class="check-card__detail" :title="localized(check, 'detail')">{{ localized(check, 'detail') }}</p>
                <p class="check-card__action" v-if="check.action">{{ localized(check, 'action') }}</p>
                <p class="check-card__action" v-if="physicalDeviceDocumentation(check.id)">
                  {{ t('overview.page.physicalDocumentationBefore') }}
                  <a :href="physicalDeviceDocumentation(check.id)">{{ t('overview.page.documentationLink') }}</a>.
                </p>
                <command-block v-for="command in check.commands ?? []" :key="command" :value="command"></command-block>
                <details class="device-options" v-if="check.devices?.length">
                  <summary>
                    <i class="fa-solid fa-mobile-screen-button" aria-hidden="true"></i> {{
                    t('overview.page.showDevices', { count: check.devices.length }, check.devices.length) }}
                  </summary>
                  <div class="device-options__list">
                    <article
                      v-for="device in check.devices"
                      :key="device.id ?? device.name"
                      :class="['device-option', { 'is-incompatible': !device.compatible }]"
                    >
                      <div class="device-option__heading">
                        <strong>{{ device.name }}</strong
                        ><span
                          >{{ t(device.compatible ? 'overview.page.ready' : 'overview.page.needsAttention') }}</span
                        >
                      </div>
                      <small>{{ deviceMeta(device) }}</small
                      ><small class="device-option__detail" v-if="device.detail"
                        >{{ localized(device, 'detail') }}</small
                      ><a v-if="device.documentationUrl" :href="device.documentationUrl"
                        >{{ t('overview.page.openSigningGuide') }}</a
                      ><command-block v-if="device.compatible" :value="deviceConfig(device)"></command-block>
                    </article>
                  </div>
                </details>
              </article>
            </div>
          </div>
          <div class="guided-actions" id="environment-setup" v-if="workbench.actions?.length">
            <div class="guided-actions__content">
              <div class="guided-actions__heading">
                <div>
                  <h3>{{ t('overview.page.environmentSetup') }}</h3>
                  <p id="setup-summary">{{ setupSummary }}</p>
                </div>
              </div>
              <div class="setup-action-list" id="setup-action-list">
                <div class="setup-action" v-for="action in workbench.actions" :key="action.id ?? action.label">
                  <div class="setup-action__copy">
                    <strong>{{ localized(action, 'label') }}</strong><small>{{ actionDetail(action) }}</small>
                  </div>
                  <button
                    v-if="isInstallable(action)"
                    class="button button--secondary setup-action__status"
                    :class="`is-${action.status}`"
                    type="button"
                    :disabled="setupBusy(action)"
                    :aria-busy="setupBusy(action) ? 'true' : null"
                    @click="setup(action)"
                  >
                    <i
                      :class="['fa-solid', setupBusy(action) ? 'fa-spinner fa-spin' : 'fa-download']"
                      aria-hidden="true"
                    ></i>
                    {{ setupBusy(action) ? t('overview.page.installing') : t('overview.page.install') }}</button
                  ><span v-else class="setup-action__status" :class="`is-${action.status}`"
                    ><i :class="['fa-solid', actionStatusIcon(action.status)]" aria-hidden="true"></i> {{
                    actionStatus(action.status) }}</span
                  ><command-block v-if="action.command" :value="action.command"></command-block>
                </div>
              </div>
            </div>
          </div>
          <div class="integration-card" v-if="selectedMcpClient">
            <span class="integration-card__icon"><i class="fa-solid fa-plug" aria-hidden="true"></i></span>
            <div class="integration-card__content">
              <div class="integration-card__heading">
                <div>
                  <h3>{{ t('overview.page.mcpTitle') }}</h3>
                  <p>{{ t('overview.page.mcpIntro') }}</p>
                </div>
                <button
                  class="button button--secondary"
                  id="register-mcp"
                  type="button"
                  v-if="selectedMcpClient.automatic && !selectedMcpClient.current && selectedMcpClient.installed"
                  :aria-busy="actionBusy === 'mcp' ? 'true' : null"
                  :disabled="actionBusy === 'mcp'"
                  @click="registerMcp"
                >
                  <i
                    :class="['fa-solid', actionBusy === 'mcp' ? 'fa-spinner fa-spin' : 'fa-link']"
                    aria-hidden="true"
                  ></i>
                  {{ actionBusy === 'mcp' ? t('overview.page.connecting') : t('overview.page.automaticSetup') }}
                </button>
              </div>
              <label class="integration-client"
                ><span>{{ t('overview.page.assistant') }}</span
                ><span class="select-control"
                  ><select
                    id="mcp-client"
                    v-model="selectedMcpClientId"
                    :aria-label="t('overview.page.selectAssistant')"
                  >
                    <option v-for="client in workbench.mcpClients" :key="client.id" :value="client.id">
                      {{ mcpLabel(client) }}
                    </option></select
                  ><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span
              ></label>
              <p
                id="mcp-status"
                :class="['integration-status', selectedMcpClient.current ? 'is-ready' : selectedMcpClient.installed ? 'is-action' : 'is-blocked']"
              >
                {{ mcpDetail(selectedMcpClient) }}
              </p>
              <p id="mcp-instruction">{{ mcpInstruction(selectedMcpClient) }}</p>
              <div id="mcp-command">
                <command-block
                  :value="selectedMcpClient.command"
                  :multiline="selectedMcpClient.format === 'json'"
                ></command-block>
              </div>
            </div>
          </div>
        </div>
      </details>
    </template>
  </div>
</template>
<overview-page></overview-page>
