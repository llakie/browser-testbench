<template id="targets-page-template">
  <div>
    <section class="hero hero--compact">
      <div>
        <p class="eyebrow">{{ t('targets.page.eyebrow') }}</p>
        <h1><%= it.t("targets.page.title") %></h1>
        <p class="hero__copy">{{ t('targets.page.intro') }}</p>
      </div>
    </section>
    <div
      id="notice"
      :class="['notice', store.state.notice?.kind ? `is-${store.state.notice.kind}` : '']"
      role="status"
      aria-live="polite"
      v-if="store.state.notice"
    >
      {{ store.state.notice.message }}
    </div>
    <template v-if="workbench">
      <section class="panel" id="test-targets">
        <div class="section-heading">
          <div>
            <p class="eyebrow">{{ t('targets.page.convention') }}</p>
            <h2>{{ t('targets.page.targetsTitle') }}</h2>
            <p>{{ t('targets.page.targetsIntro') }}</p>
          </div>
          <button
            class="button button--secondary"
            id="verify-all-targets"
            type="button"
            v-if="readyTargets.length"
            :disabled="store.busy"
            @click="verifyAll"
          >
            <i :class="['fa-solid', runningAll ? 'fa-spinner fa-spin' : 'fa-list-check']" aria-hidden="true"></i>
            <span v-if="runningAll">{{ t('targets.page.checkingTargets') }}</span>
            <span v-else><%= it.t("targets.page.runAll") %></span>
          </button>
        </div>
        <div class="test-target-list" id="test-target-list" aria-live="polite">
          <article
            v-for="target in workbench.testTargets"
            :key="target.id"
            :class="['test-target', `is-${target.status}`]"
          >
            <div class="test-target__content">
              <div class="test-target__heading">
                <strong>{{ localized(target, 'label') }}</strong
                ><span :class="['test-target__status', `is-${target.status}`]"
                  ><i :class="['fa-solid', statusIcon(target.status)]" aria-hidden="true"></i> {{ availability(target)
                  }}</span
                >
              </div>
              <small>{{ localized(target, 'detail') }}</small
              ><small
                v-if="verification(target) || target.verifiedAt"
                :class="['test-target__verification', `is-${verification(target)?.status ?? 'passed'}`]"
                ><i :class="['fa-solid', verificationIcon(target)]" aria-hidden="true"></i> {{
                verificationMessage(target) }}</small
              >
            </div>
            <div class="test-target__actions">
              <command-block :value="target.id" copy-label="targetId"></command-block
              ><button
                v-if="target.ready"
                class="button button--secondary"
                type="button"
                :disabled="store.busy || target.busy || verification(target)?.status === 'running'"
                @click="verifyTarget(target)"
              >
                <i
                  :class="['fa-solid', verification(target)?.status === 'running' ? 'fa-spinner fa-spin' : 'fa-circle-play']"
                  aria-hidden="true"
                ></i>
                {{ verification(target)?.status === 'running' ? t('targets.page.runningShort') :
                t('targets.page.runTest') }}
              </button>
            </div>
          </article>
        </div>
      </section>
      <section class="panel" id="connect">
        <div class="section-heading">
          <div>
            <p class="eyebrow">{{ t('targets.page.projectEyebrow') }}</p>
            <h2>{{ t('targets.page.useTitle') }}</h2>
            <p>{{ t('targets.page.useIntro') }}</p>
          </div>
        </div>
        <div class="project-command">
          <span class="integration-card__icon"><i class="fa-solid fa-satellite-dish" aria-hidden="true"></i></span>
          <div>
            <h3>{{ t('targets.page.installTitle') }}</h3>
            <p>{{ t('targets.page.installIntro') }}</p>
            <div id="project-install-command">
              <command-block :value="workbench.clientInstallCommand"></command-block>
            </div>
          </div>
        </div>
        <div class="project-command">
          <span class="integration-card__icon"><i class="fa-solid fa-play" aria-hidden="true"></i></span>
          <div>
            <h3>{{ t('targets.page.testTitle') }}</h3>
            <p>{{ t('targets.page.testIntro') }}</p>
            <div id="project-client-example"><command-block :value="clientExample" multiline></command-block></div>
          </div>
        </div>
        <div class="project-command">
          <span class="integration-card__icon"><i class="fa-solid fa-bug" aria-hidden="true"></i></span>
          <div>
            <h3>{{ t('targets.page.debugTitle') }}</h3>
            <p>{{ t('targets.page.debugIntro') }}</p>
            <div class="debug-controls">
              <label
                ><span>{{ t('targets.page.applicationUrl') }}</span>
                <div class="input-with-icon">
                  <i class="fa-solid fa-link" aria-hidden="true"></i
                  ><input
                    id="debug-url"
                    v-model="debugUrl"
                    type="url"
                    :placeholder="applicationUrlPlaceholder"
                  /></div></label
              ><label
                ><span>{{ t('targets.page.browserOrDevice') }}</span
                ><span class="select-control"
                  ><select id="debug-target" v-model="debugTargetId">
                    <option v-for="target in workbench.testTargets" :key="target.id" :value="target.id">
                      {{ localized(target, 'label') }}{{ target.ready ? '' : ` ·
                      ${t('targets.page.setupRequiredSuffix')}` }}
                    </option></select
                  ><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span
              ></label>
              <button
                class="button button--secondary"
                id="start-debug-session"
                type="button"
                :disabled="!canStartDebugSession"
                @click="startDebugSession"
              >
                <i
                  :class="['fa-solid', startingDebugSession ? 'fa-spinner fa-spin' : 'fa-arrow-up-right-from-square']"
                  aria-hidden="true"
                ></i>
                {{ startingDebugSession ? t('targets.page.openingDebugSession') : t('targets.page.openDebugSession') }}
              </button>
            </div>
            <p class="debug-tools-note" id="local-network-address" v-if="workbench.connection.mode === 'remote'">
              {{ t('targets.page.remoteLocalhost') }}
              <template v-if="networkApplicationUrl"
                >{{ t('targets.page.remoteAddress', { url: networkApplicationUrl }) }}</template
              ><template v-else>{{ t('targets.page.remoteAddressFallback') }}</template>
            </p>
            <p class="debug-command-alternative">{{ t('targets.page.commandAlternative') }}</p>
            <div id="debug-open-command"><command-block v-if="debugCommand" :value="debugCommand"></command-block></div>
            <p class="debug-tools-note" id="debug-tools-note">{{ debugNote }}</p>
            <section class="debug-sessions" aria-live="polite">
              <div class="debug-sessions__heading">
                <h4>{{ t('targets.page.activeDebugSessions') }}</h4>
                <span v-if="loadingDebugSessions"
                  ><i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i> {{
                  t('targets.page.loadingDebugSessions') }}</span
                >
              </div>
              <p class="debug-sessions__empty" v-if="!loadingDebugSessions && !debugSessions.length">
                {{ t('targets.page.noActiveDebugSessions') }}
              </p>
              <div class="debug-session-list" id="debug-session-list" v-else>
                <article class="debug-session" v-for="session in debugSessions" :key="session.id">
                  <div class="debug-session__details">
                    <div class="debug-session__heading">
                      <strong>{{ debugSessionLabel(session) }}</strong
                      ><span class="debug-session__status"
                        ><i class="fa-solid fa-circle" aria-hidden="true"></i> {{ t('targets.page.debugSessionActive')
                        }}</span
                      >
                    </div>
                    <small
                      >{{ t('targets.page.debugSessionStartedAt', { date: debugSessionStartedAt(session) }) }}</small
                    >
                    <p>{{ debugSessionNote(session) }}</p>
                  </div>
                  <div class="debug-session__actions">
                    <a
                      v-if="openableDevToolsUrl(session)"
                      class="button button--secondary open-devtools"
                      :href="openableDevToolsUrl(session)"
                      target="_blank"
                      rel="noopener noreferrer"
                      ><i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i> {{
                      t('targets.page.openDevTools') }}</a
                    ><command-block
                      v-else-if="session.devtools?.url && workbench.connection.mode === 'local'"
                      :value="session.devtools.url"
                    ></command-block
                    ><button
                      class="button button--secondary close-debug-session"
                      type="button"
                      :disabled="Boolean(closingDebugSessionId)"
                      @click="closeDebugSession(session)"
                    >
                      <i
                        :class="['fa-solid', closingDebugSessionId === session.id ? 'fa-spinner fa-spin' : 'fa-xmark']"
                        aria-hidden="true"
                      ></i>
                      {{ closingDebugSessionId === session.id ? t('targets.page.closingDebugSession') :
                      t('targets.page.closeDebugSession') }}
                    </button>
                  </div>
                </article>
              </div>
            </section>
          </div>
        </div>
      </section>
    </template>
  </div>
</template>
<targets-page></targets-page>
