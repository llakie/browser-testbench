<template id="targets-page-template">
  <div>
    <section class="hero hero--compact">
      <div>
        <p class="eyebrow">Remote control and verification</p>
        <h1>Test targets</h1>
        <p class="hero__copy">
          Use stable IDs in your projects or verify all available browsers and devices right here.
        </p>
      </div>
    </section>
    <div
      id="notice"
      :class="['notice', store.state.notice?.kind ? `is-${store.state.notice.kind}` : '']"
      role="status"
      aria-live="polite"
      v-if="store.state.notice"
    >
      {{ store.state.notice.message }}
    </div>
    <template v-if="workbench">
      <section class="panel" id="test-targets">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Convention over Configuration</p>
            <h2>Targets for your tests</h2>
            <p>
              Use these unique IDs directly in your tests. “Ready” confirms the environment; a successful test run also
              displays its date.
            </p>
          </div>
          <button
            class="button button--secondary"
            id="verify-all-targets"
            type="button"
            v-if="readyTargets.length"
            :disabled="store.busy"
            @click="verifyAll"
          >
            <i :class="['fa-solid', runningAll ? 'fa-spinner fa-spin' : 'fa-list-check']" aria-hidden="true"></i> {{
            runningAll ? 'Checking targets …' : 'Run all tests' }}
          </button>
        </div>
        <div class="test-target-list" id="test-target-list" aria-live="polite">
          <article
            v-for="target in workbench.testTargets"
            :key="target.id"
            :class="['test-target', `is-${target.status}`]"
          >
            <div class="test-target__content">
              <div class="test-target__heading">
                <strong>{{ target.label }}</strong
                ><span :class="['test-target__status', `is-${target.status}`]"
                  ><i :class="['fa-solid', statusIcon(target.status)]" aria-hidden="true"></i> {{ availability(target)
                  }}</span
                >
              </div>
              <small>{{ target.detail }}</small
              ><small
                v-if="verification(target) || target.verifiedAt"
                :class="['test-target__verification', `is-${verification(target)?.status ?? 'passed'}`]"
                ><i :class="['fa-solid', verificationIcon(target)]" aria-hidden="true"></i> {{
                verificationMessage(target) }}</small
              >
            </div>
            <div class="test-target__actions">
              <command-block :value="target.id" copy-label="Target ID"></command-block
              ><button
                v-if="target.ready"
                class="button button--secondary"
                type="button"
                :disabled="store.busy || target.busy || verification(target)?.status === 'running'"
                @click="verifyTarget(target)"
              >
                <i
                  :class="['fa-solid', verification(target)?.status === 'running' ? 'fa-spinner fa-spin' : 'fa-circle-play']"
                  aria-hidden="true"
                ></i>
                {{ verification(target)?.status === 'running' ? 'Test running …' : 'Run test' }}
              </button>
            </div>
          </article>
        </div>
      </section>
      <section class="panel" id="connect">
        <div class="section-heading">
          <div>
            <p class="eyebrow">In your project</p>
            <h2>Use Browser Testbench</h2>
            <p>URLs, assertions, and result directories remain entirely in your project.</p>
          </div>
        </div>
        <div class="project-command">
          <span class="integration-card__icon"><i class="fa-solid fa-satellite-dish" aria-hidden="true"></i></span>
          <div>
            <h3>Install the client in your project</h3>
            <p>Install Browser Testbench as a development dependency in your project.</p>
            <div id="project-install-command">
              <command-block :value="workbench.clientInstallCommand"></command-block>
            </div>
          </div>
        </div>
        <div class="project-command">
          <span class="integration-card__icon"><i class="fa-solid fa-play" aria-hidden="true"></i></span>
          <div>
            <h3>Use it in your own test</h3>
            <p>Your test opens the session. The flow and assertions remain with your test runner.</p>
            <div id="project-client-example"><command-block :value="clientExample" multiline></command-block></div>
          </div>
        </div>
        <div class="project-command">
          <span class="integration-card__icon"><i class="fa-solid fa-bug" aria-hidden="true"></i></span>
          <div>
            <h3>Open a browser for debugging</h3>
            <p>
              Open a URL directly. The session stays active until you press <kbd>Ctrl</kbd> + <kbd>C</kbd> in the
              terminal.
            </p>
            <div class="debug-controls">
              <label
                ><span>Application URL</span>
                <div class="input-with-icon">
                  <i class="fa-solid fa-link" aria-hidden="true"></i
                  ><input
                    id="debug-url"
                    v-model="debugUrl"
                    type="url"
                    :placeholder="applicationUrlPlaceholder"
                  /></div></label
              ><label
                ><span>Browser or device</span
                ><span class="select-control"
                  ><select id="debug-target" v-model="debugTargetId">
                    <option v-for="target in workbench.testTargets" :key="target.id" :value="target.id">
                      {{ target.label }}{{ target.ready ? '' : ' · Setup required' }}
                    </option></select
                  ><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span
              ></label>
            </div>
            <p class="debug-tools-note" id="local-network-address" v-if="workbench.connection.mode === 'remote'">
              Remote browsers cannot use this computer's localhost.
              <template v-if="networkApplicationUrl"
                >Bind your application to the LAN and use <code>{{ networkApplicationUrl }}</code>.</template
              ><template v-else>Bind your application to the LAN and use this computer's LAN address.</template>
            </p>
            <div id="debug-open-command"><command-block v-if="debugCommand" :value="debugCommand"></command-block></div>
            <p class="debug-tools-note" id="debug-tools-note">{{ debugNote }}</p>
          </div>
        </div>
      </section>
    </template>
  </div>
</template>
<targets-page></targets-page>
