<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title><%= it.title %> · Setup</title>
    <link rel="stylesheet" href="/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/fontawesome/css/solid.min.css" />
    <link rel="stylesheet" href="/ui-assets/setup.css" />
    <script type="module" src="/ui-assets/setup.js"></script>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/setup" aria-label="Browser Testbench Startseite">
        <span class="brand__mark"><i class="fa-solid fa-flask-vial" aria-hidden="true"></i></span>
        <span>
          <strong>Browser Testbench</strong>
          <small>Lokale Browser- und Gerätetests</small>
        </span>
      </a>
      <div class="host-badge" id="host-badge" aria-live="polite">
        <i class="fa-solid fa-circle-notch fa-spin" aria-hidden="true"></i>
        Umgebung wird erkannt
      </div>
    </header>

    <main class="shell">
      <section class="hero">
        <div>
          <p class="eyebrow">Get going</p>
          <h1>Vom Projekt zum echten Browser-Test.</h1>
          <p class="hero__copy">
            Verbinde deine Anwendung, wähle die verfügbaren Browser und starte den ersten Lauf – Server und Artefakte
            übernimmt die Testbench.
          </p>
        </div>
        <div class="config-location">
          <i class="fa-solid fa-file-code" aria-hidden="true"></i>
          <span>
            <small>Konfigurationsdatei</small>
            <code id="config-path">wird geladen …</code>
          </span>
        </div>
      </section>

      <nav class="steps" aria-label="Setup-Schritte">
        <a href="#environment"><span>1</span> Umgebung</a>
        <a href="#project"><span>2</span> Projekt</a>
        <a href="#targets"><span>3</span> Ziele</a>
        <a href="#run"><span>4</span> Testlauf</a>
      </nav>

      <div id="notice" class="notice" role="status" aria-live="polite" hidden></div>

      <section class="panel" id="environment">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Schritt 1</p>
            <h2>Deine Umgebung</h2>
            <p>Nur sichere Prüfungen laufen automatisch. Schritte mit Systemrechten bleiben bewusst bei dir.</p>
          </div>
          <button class="button button--secondary" id="refresh-environment" type="button">
            <i class="fa-solid fa-rotate" aria-hidden="true"></i> Neu prüfen
          </button>
        </div>
        <div class="check-grid" id="checks" aria-live="polite"></div>
        <div class="guided-actions" id="guided-actions" hidden>
          <div>
            <h3>Geführtes Setup</h3>
            <p id="setup-summary">Automatisierbare Abhängigkeiten können direkt eingerichtet werden.</p>
          </div>
          <button class="button button--secondary" id="run-setup" type="button">
            <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Setup ausführen
          </button>
        </div>
      </section>

      <form id="configuration-form">
        <section class="panel" id="project">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Schritt 2</p>
              <h2>Projekt verbinden</h2>
              <p>Der Projektserver wird vor jedem Lauf gestartet und danach wieder sauber beendet.</p>
            </div>
            <span class="save-state" id="save-state"
              ><i class="fa-solid fa-circle" aria-hidden="true"></i> Ungespeichert</span
            >
          </div>

          <div class="form-grid">
            <label>
              <span>Projektname</span>
              <input id="project-name" name="name" required autocomplete="off" />
            </label>
            <label>
              <span>URL der Anwendung</span>
              <input id="base-url" name="baseUrl" type="url" required placeholder="http://127.0.0.1:3000" />
              <small>Hier wartet die Testbench, bis deine Anwendung erreichbar ist.</small>
            </label>
            <label class="form-grid__wide">
              <span>Startbefehl</span>
              <div class="input-with-icon">
                <i class="fa-solid fa-terminal" aria-hidden="true"></i>
                <input id="server-command" name="serverCommand" placeholder="npm run dev" autocomplete="off" />
              </div>
              <small>Leer lassen, wenn du den Server selbst startest.</small>
            </label>
            <label>
              <span>Arbeitsverzeichnis</span>
              <input id="server-cwd" name="serverCwd" placeholder="." autocomplete="off" />
            </label>
            <label>
              <span>Optionaler Health-Check</span>
              <input id="health-url" name="healthUrl" type="url" placeholder="http://127.0.0.1:3000/health" />
            </label>
            <label class="form-grid__wide">
              <span>Testdateien</span>
              <input id="specs" name="specs" placeholder="tests/browser/**/*.spec.mjs" autocomplete="off" />
              <small>Mehrere Glob-Muster mit Komma trennen.</small>
            </label>
          </div>

          <details class="advanced">
            <summary><i class="fa-solid fa-sliders" aria-hidden="true"></i> Erweiterte JSON-Konfiguration</summary>
            <p>Direkte Änderungen werden vor dem Speichern validiert und mit dem Formular synchronisiert.</p>
            <label>
              <span class="sr-only">JSON-Konfiguration</span>
              <textarea id="json-editor" spellcheck="false" rows="18"></textarea>
            </label>
            <button class="button button--quiet" id="apply-json" type="button">
              <i class="fa-solid fa-arrow-up-from-bracket" aria-hidden="true"></i> JSON ins Formular übernehmen
            </button>
          </details>
        </section>

        <section class="panel" id="targets">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Schritt 3</p>
              <h2>Browser und Geräte</h2>
              <p id="target-help">
                Angezeigt werden die Ziele, die auf diesem Rechner grundsätzlich unterstützt werden.
              </p>
            </div>
          </div>
          <div class="target-grid" id="target-list"></div>
        </section>

        <section class="panel run-panel" id="run">
          <div>
            <p class="eyebrow">Schritt 4</p>
            <h2>Bereit für den ersten Lauf?</h2>
            <p>Speichern wirkt sofort. Beim Start liest die Testbench die aktuelle JSON-Datei neu ein.</p>
          </div>
          <div class="run-actions">
            <button class="button button--secondary" id="save-config" type="submit">
              <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Speichern
            </button>
            <button class="button button--primary" id="save-and-run" type="button">
              <i class="fa-solid fa-play" aria-hidden="true"></i> Speichern &amp; testen
            </button>
          </div>
        </section>
      </form>

      <section class="panel results" id="results" hidden>
        <div class="section-heading">
          <div>
            <p class="eyebrow">Testlauf</p>
            <h2 id="result-title">Tests laufen …</h2>
            <p id="result-copy">Der konfigurierte Projektserver wird vorbereitet.</p>
          </div>
          <span class="run-status status--running" id="run-status">
            <i class="fa-solid fa-circle-notch fa-spin" aria-hidden="true"></i> Läuft
          </span>
        </div>
        <div class="result-grid" id="result-grid"></div>
      </section>
    </main>

    <footer>
      <span><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Lokal, portabel und ohne Cloud-Zwang</span>
      <a href="/health">API-Status</a>
    </footer>
  </body>
</html>
