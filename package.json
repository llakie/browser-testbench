{
  "name": "browser-testbench",
  "version": "0.2.0",
  "description": "Cross-platform testbench for desktop browsers, iOS simulators and devices, and Android emulators and devices",
  "author": "Lars-Erich Kiefer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llakie/browser-testbench.git"
  },
  "bugs": {
    "url": "https://github.com/llakie/browser-testbench/issues"
  },
  "homepage": "https://github.com/llakie/browser-testbench#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "browser-testing",
    "browser-automation",
    "appium",
    "selenium",
    "ios-simulator",
    "android-emulator",
    "android-device",
    "mcp"
  ],
  "type": "module",
  "bin": {
    "browser-testbench": "dist/cli.js"
  },
  "exports": {
    "./client": {
      "types": "./dist/transports/testbench-client.d.ts",
      "import": "./dist/transports/testbench-client.js"
    }
  },
  "files": [
    "dist",
    "docs/assets",
    "public",
    "templates",
    "LICENSE.txt",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "scripts": {
    "build": "npm run licenses && npm run clean && npm run build:ui && tsc -p tsconfig.json && node scripts/prepare-cli.mjs",
    "build:ui": "vite build",
    "dev": "node scripts/develop.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json && tsc -p tsconfig.ui.json",
    "clean": "rimraf dist",
    "fixture:server": "node tests/fixtures/site-server.mjs",
    "format": "prettier --write . \"templates/**/*.eta\"",
    "format:check": "prettier --check . \"templates/**/*.eta\"",
    "licenses": "node scripts/generate-licenses.mjs",
    "licenses:check": "node scripts/generate-licenses.mjs --check",
    "pretest": "npm run build:ui",
    "test": "vitest run",
    "pretest:watch": "npm run build:ui",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "appium": "3.7.0",
    "bonjour-service": "1.4.4",
    "commander": "15.0.0",
    "eta": "4.6.0",
    "express": "5.2.1",
    "open": "11.0.4",
    "selenium-webdriver": "4.49.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.3",
    "@types/selenium-webdriver": "4.35.7",
    "generate-license-file": "4.2.3",
    "prettier": "3.9.6",
    "prettier-plugin-eta": "0.2.11",
    "rimraf": "6.1.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue": "3.5.42"
  },
  "overrides": {
    "morgan": "1.12.1"
  }
}
